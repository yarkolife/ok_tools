        "denoise_nf_db": -25,
        "compressor": { "threshold_db": -22, "ratio": 2.0, "attack_ms": 20, "release_ms": 450 },
        "limiter_db": -1.5,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 11, "linear": true }
      }
    },
    {
      "id": "tv_strong",
      "title": "TV Strong (archive/noise/jumps)",
      "tags": ["tv", "strong"],
      "filters": {
        "highpass_hz": 80,
        "denoise_nf_db": -30,
        "compressor": { "threshold_db": -24, "ratio": 3.0, "attack_ms": 15, "release_ms": 350 },
        "limiter_db": -2.0,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 9, "linear": true }
      }
    },
    {
      "id": "fast_auto",
      "title": "Fast Auto (dynamic loudnorm)",
      "tags": ["fast"],
      "filters": {
        "highpass_hz": 70,
        "denoise_nf_db": -25,
        "limiter_db": -1.5,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 11, "linear": false }
