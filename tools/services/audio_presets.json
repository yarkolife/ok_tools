      "filters": {
        "highpass_hz": 80,
        "arnndn_mix": 0.8,
        "lowpass_hz": 16000,
        "compressor": { "threshold_db": -22, "ratio": 2.5, "attack_ms": 20, "release_ms": 400 },
        "limiter_db": -1.0,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 11, "linear": true }
      }
    },
    {
      "id": "tv_ai_strong",
      "title": "TV AI Strong (neural denoiser + aggressive)",
      "tags": ["tv", "ai", "strong", "noise"],
      "filters": {
        "highpass_hz": 80,
        "arnndn_mix": 0.85,
        "lowpass_hz": 16000,
        "compressor": { "threshold_db": -24, "ratio": 3.0, "attack_ms": 15, "release_ms": 350 },
        "limiter_db": -1.0,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 9, "linear": true }
      }
    },
    {
      "id": "tv_mixed",
