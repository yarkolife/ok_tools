msgid "Sync Settings"
msgstr "Synchronisierungseinstellungen"

msgid ""
"Note: Periodic sync schedule is managed via <a href=\"/admin/"
"django_celery_beat/periodictask/\" target=\"_blank\">Periodic Tasks</a> "
"(task name: \"sync_exchange_folders\"). You can enable/disable and change "
"schedule there."
msgstr ""
"Hinweis: Der periodische Synchronisationszeitplan wird über <a href=\"/admin/django_celery_beat/periodictask/\" target=\"_blank\">Periodische Aufgaben</a> (Aufgabenname: \"sync_exchange_folders\") gesteuert. Sie können ihn dort aktivieren/deaktivieren und den Zeitplan ändern."

