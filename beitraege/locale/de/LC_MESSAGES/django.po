#: templates/email/beitrag_abgelehnt_body.txt:1
#, python-format
msgid "Your post \"%(titel)s\" was not approved by %(von)s."
msgstr "Dein Beitrag „%(titel)s“ wurde von %(von)s nicht freigegeben."

#: templates/email/beitrag_abgelehnt_body.txt:3
msgid "Reason"
msgstr "Grund"

#: templates/email/beitrag_abgelehnt_body.txt:5
msgid "Change it and submit it again:"
msgstr "Bitte ändern und erneut einreichen:"

#: templates/email/beitrag_abgelehnt_subject.txt:1
#, python-format
msgid "Post not approved: %(titel)s"
msgstr "Beitrag nicht freigegeben: %(titel)s"

#: templates/email/beitrag_code_fehlt_body.txt:1
#, python-format
msgid ""
"Your mail \"%(subject)s\" did not become a post: the code for posts was "
"missing in the subject, or it is an old one."
msgstr ""
"Aus deiner E-Mail „%(subject)s“ ist kein Beitrag geworden: Der Code für "
"Beiträge fehlte im Betreff, oder es ist ein alter."

#: templates/email/beitrag_code_fehlt_body.txt:3
msgid ""
"The current code and the address are shown on the page \"New post\" (login "
"needed):"
msgstr ""
"Den aktuellen Code und die Adresse zeigt die Seite „Neuer Beitrag“ "
"(Anmeldung nötig):"

#: templates/email/beitrag_code_fehlt_body.txt:6
msgid "Send the mail again with the code in the subject."
msgstr "Bitte die E-Mail mit dem Code im Betreff erneut senden."

#: templates/email/beitrag_code_fehlt_subject.txt:1
msgid "Your mail was not taken as a post"
msgstr "Deine E-Mail wurde nicht als Beitrag übernommen"

#: templates/email/beitrag_eingang_body.txt:1
#, python-format
msgid ""
"Your mail has become the post \"%(titel)s\" in the topic \"%(thema)s\" with "
"%(fotos)s photo(s)."
msgstr ""
"Aus deiner E-Mail ist der Beitrag „%(titel)s“ im Thema „%(thema)s“ mit "
"%(fotos)s Foto(s) geworden."

