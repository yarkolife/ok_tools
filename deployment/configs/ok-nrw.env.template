# ============================================================================
# OK Tools Production Environment Configuration for NRW
# Template file: Fill in your specific values
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=oktools
POSTGRES_USER=oktools
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oktools:__REPLACE_ME__@db:5432/oktools

# ============================================================================
# Django Configuration
# ============================================================================
DJANGO_SETTINGS_MODULE=ok_tools.settings
DJANGO_SECRET_KEY=__REPLACE_ME__
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.1,__REPLACE_ME__

# ============================================================================
# Organization Configuration
# ============================================================================
ORG_NAME=NRW Community Media Organization e.V.
ORG_SHORT_NAME=NRW CMO
ORG_WEBSITE=https://nrw-your-domain.com
ORG_EMAIL=info@nrw-your-domain.com
ORG_ADDRESS=NRW Street 123\nNRW City, Postal Code
ORG_PHONE=+49 123 456789
ORG_FAX=+49 123 456790
ORG_DESCRIPTION=Welcome to our NRW Community Media Organization!
ORG_OPENING_HOURS=Mon: 13:00 – 16:00\nTue – Thu: 10:00 – 18:00\nFri: 10:00 – 16:00
STATE_MEDIA_INSTITUTION=MSA

# ============================================================================
# Superuser Configuration (for initial setup)
# ============================================================================
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@nrw-your-domain.com
SUPERUSER_PASSWORD=__REPLACE_ME__

# ============================================================================
# Application Configuration
# ============================================================================
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# ============================================================================
# Registration Form Configuration
# ============================================================================
# PDF template file for registration form (must be in files/ directory)
# Options: Nutzerkartei.pdf, Nutzerkartei_Anmeldung_2022_n.pdf
REGISTRATION_FORM_PDF=Nutzerkartei.pdf

# Registration form type: PDF, HTML, or TEXT
# PDF - generates filled PDF form using pdftk
# HTML - generates HTML form (can be printed from browser)
# TEXT - generates plain text form
REGISTRATION_FORM_TYPE=PDF

# ============================================================================
# Gunicorn Configuration
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ============================================================================
# Redis Configuration (for caching and Celery)
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# SSL/HTTPS Configuration
# ============================================================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_DIR=/app/backups

# ============================================================================
# Volume Mounts Configuration (for docker-compose.override.yml)
# ============================================================================
# NAS mount path (leave empty if not using NAS)
# Example: NAS_MOUNT_PATH=/mnt/nas
NAS_MOUNT_PATH=
NAS_MOUNT_MODE=ro

# Custom volume mounts (optional, for additional storage)
# Example:
# CUSTOM_MOUNT_1_PATH=/mnt/storage1
# CUSTOM_MOUNT_1_CONTAINER_PATH=/mnt/storage1
# CUSTOM_MOUNT_1_MODE=ro
# CUSTOM_MOUNT_1_SERVICES=web,celery_worker
# CUSTOM_MOUNT_2_PATH=/mnt/storage2
# CUSTOM_MOUNT_2_CONTAINER_PATH=/mnt/storage2
# CUSTOM_MOUNT_2_MODE=rw
# CUSTOM_MOUNT_2_SERVICES=web

# ============================================================================
# Django Extended Configuration
# ============================================================================
DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE=de-de
DJANGO_TIMEZONE=Europe/Berlin
DJANGO_STATIC_ROOT=/app/staticfiles/
DJANGO_MEDIA_ROOT=/app/media/
USE_SECURE_SETTINGS=True

# ============================================================================
# Email Configuration
# ============================================================================
EMAIL_HOST=smtp.your-provider.de
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@ok-nrw.de
EMAIL_HOST_PASSWORD=__REPLACE_ME__
DEFAULT_FROM_EMAIL=noreply@ok-nrw.de
MAIL_DEV_SETTINGS=False

# ============================================================================
# Rental Email Approval Configuration
# ============================================================================
# Enable email-based approval workflow for user-created rental requests
# When enabled, user requests are created as 'draft' and require admin approval
# Admins receive email with approve/deny links; users receive status notifications
RENTAL_USER_REQUEST_REQUIRES_APPROVAL=false
# Base URL for approval links in emails (must match your production domain)
# Example: https://ok-nrw.your-domain.com
SITE_BASE_URL=https://ok-nrw-your-domain.com
# Optional: Explicit list of admin email addresses to notify
# If not set, all active staff users with email addresses will be notified
# Format: email1@example.com,email2@example.com
RENTAL_APPROVAL_RECIPIENT_EMAILS=
# Optional: Token expiration time for approve/deny links (in seconds)
# Default: 7 days (604800 seconds)
RENTAL_APPROVAL_TOKEN_MAX_AGE_SECONDS=604800

# ============================================================================
# Organization Extended Configuration
# ============================================================================
ORG_ORGANIZATION_OWNER=OK NRW
ORG_BROADCAST_START=18:00
ORG_BROADCAST_END=19:45
ORG_PEERTUBE_CHANNEL=

# ============================================================================
# Logging Configuration Extended
# ============================================================================
LOGGING_FILE=/app/logs/oktools.log

# ============================================================================
# Bootstrap Configuration
# ============================================================================
BOOTSTRAP_VERSION=5.3.3
BOOTSTRAP_ICONS_VERSION=1.11.0
DASHBOARD_THEME=default  # or dark, vibrant

# ============================================================================
# API Configuration
# ============================================================================
API_PAGE_SIZE=20
API_ANON_RATE_LIMIT=100/hour
API_USER_RATE_LIMIT=1000/hour

# ============================================================================
# Security Configuration
# ============================================================================
SECURITY_SESSION_TIMEOUT=1200
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_CSRF_COOKIE_AGE=31449600

# ============================================================================
# Video Configuration
# ============================================================================
VIDEO_SUPPORTED_FORMATS=mp4,mov,mpeg,mpg
VIDEO_SCREEN_BOARD_DURATION=20
# Includes a video editor for adding text overlays at the beginning and end of videos:
# Title, subtitle, author, channel, year
VIDEO_OVERLAY_RENDERING_ENABLED=true # or false

# ============================================================================
# I18n Configuration
# ============================================================================
I18N_DEFAULT_LANGUAGE=de
I18N_SUPPORTED_LANGUAGES=de,en
I18N_LOCALE_PATHS=ok_tools/locale
I18N_PHONE_REGION=DE
I18N_DATE_FORMAT=%d.%m.%Y

# ============================================================================
# Static Files Configuration
# ============================================================================
STATIC_STORAGE_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage
STATIC_URL_PREFIX=static/

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_TIMEOUT=300

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
# Number of parallel worker processes (None = auto-detect CPU cores)
# Recommended for video rendering: 2-4 (depends on CPU cores and available memory)
# Each worker process can handle one video rendering task at a time
CELERY_WORKER_CONCURRENCY=
# Task time limits (in seconds)
# Soft limit: task receives SoftTimeLimitExceeded exception but can continue
# Hard limit: task is forcefully terminated
# Recommended for video rendering: 3600-7200 (60-120 minutes) for large videos
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=4200

# ============================================================================
# Celery Beat Schedules (cron format: min hour day month weekday)
# ============================================================================
CELERY_BEAT_EXPIRE_RENTALS=*/30 * * * *
CELERY_BEAT_CLEANUP_BACKUPS=0 2 * * *
CELERY_BEAT_BACKUP_DB=0 3 * * *
CELERY_BEAT_AUTO_SCAN=0 */2 * * *
CELERY_BEAT_LINK_LICENSES=0 4 * * *
CELERY_BEAT_SYNC_VIDEOS=0 5 * * *
CELERY_BEAT_UPDATE_METADATA=0 1 1 * *

# ============================================================================
# Docker Compose Configuration
# ============================================================================
COMPOSE_PROJECT_NAME=oktools

# ============================================================================
# Nextcloud Configuration
# ============================================================================
NEXTCLOUD_ENABLED=true
NEXTCLOUD_URL=https://cloud.lokalmedial.de
NEXTCLOUD_USERNAME=okmq_tools_service
NEXTCLOUD_PASSWORD=XXXX-XXXX-xxxx-xxxx-XXXX
NEXTCLOUD_UPLOAD_FOLDER=OKMQ/Benutzer/Videos

# Nextcloud Calendar Integration (CalDAV) - Optional
# Enable automatic sync of room bookings to Nextcloud Calendar
NEXTCLOUD_CALENDAR_ENABLED=false
# CalDAV base URL (defaults to NEXTCLOUD_URL/remote.php/dav/calendars if not set)
NEXTCLOUD_CALDAV_BASE_URL=https://cloud.lokalmedial.de/remote.php/dav/calendars
# Calendar service account (can be same as NEXTCLOUD_USERNAME or different)
NEXTCLOUD_CALENDAR_USERNAME=ok-tools-bot
NEXTCLOUD_CALENDAR_PASSWORD=XXXX-XXXX-xxxx-xxxx-XXXX
# Default calendar name for all rooms (recommended: set this to use one calendar for all rooms)
# If set, all room bookings will be added to this calendar
NEXTCLOUD_DEFAULT_CALENDAR_NAME=
# Room to calendar mapping (optional, only used if NEXTCLOUD_DEFAULT_CALENDAR_NAME is not set)
# Format: "room_name:calendar_name,room_id:calendar_name"
# Example: "Studio 1:studio1,Schnittplatz 1:schnitt1"
# If neither NEXTCLOUD_DEFAULT_CALENDAR_NAME nor NEXTCLOUD_ROOM_CALENDARS is set, will try to use room name as calendar name
NEXTCLOUD_ROOM_CALENDARS=

# ============================================================================
# Video Storage Automation Configuration
# ============================================================================
# Enable automatic video copying when saving broadcast plans
# Set to true if you have ARCHIVE and PLAYOUT storage configured
VIDEO_AUTO_COPY_ON_SCHEDULE=false

# Automatically copy videos to archive storage when planning
# Requires ARCHIVE storage to be configured
VIDEO_AUTO_COPY_TO_ARCHIVE=false

# Automatically copy videos to playout storage when planning
# Requires PLAYOUT storage to be configured
VIDEO_AUTO_COPY_TO_PLAYOUT=false

# Use weekly folders (YYYY_KW_WW format) in playout storage
# Recommended: true for organized playout storage
VIDEO_USE_WEEKLY_FOLDERS=true

# Protect ARCHIVE storage from deletion
# When true: videos in ARCHIVE can be read and copied, but not deleted
# Recommended: true to prevent accidental data loss
VIDEO_ARCHIVE_PROTECTED=true

# Number of days to consider CUSTOM storage files as "recent"
# Recent CUSTOM files are preferred over ARCHIVE when selecting source
# Default: 7 days
VIDEO_SOURCE_PREFERENCE_CUSTOM_DAYS=7

# Default playout storage for main broadcasts
# If not set, auto-detects storage containing "000_Sendungen" in path or "Sendungen" in name
# Example: VIDEO_DEFAULT_PLAYOUT_STORAGE_NAME=Sendungen
# Example: VIDEO_DEFAULT_PLAYOUT_STORAGE_PATH=000_Sendungen
VIDEO_DEFAULT_PLAYOUT_STORAGE_NAME=
VIDEO_DEFAULT_PLAYOUT_STORAGE_PATH=

# Auto-delete videos from CUSTOM storage after successful copy to archive and playout
# When true: videos are moved (deleted from CUSTOM) after successful copy
# Recommended: true to keep CUSTOM storage clean and avoid duplicate records
VIDEO_AUTO_DELETE_FROM_CUSTOM=true