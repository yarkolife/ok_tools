{
  "version": 3,
  "defaults": {
    "tv": { "I": -23, "TP": -1.0, "LRA": 11, "linear": true },
    "web": { "I": -16, "TP": -1.0, "LRA": 11, "linear": true },
    "audio": { "codec": "aac", "bitrate": "192k", "sr": 48000, "force_stereo": false }
  },
  "presets": [
    {
      "id": "tv_natural",
      "title": "TV Natural (R128 -23, soft)",
      "tags": ["tv", "natural", "archive"],
      "filters": {
        "highpass_hz": 70,
        "denoise_nf_db": -25,
        "compressor": { "threshold_db": -22, "ratio": 2.0, "attack_ms": 20, "release_ms": 450 },
        "limiter_db": -1.0,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 11, "linear": true }
      }
    },
    {
      "id": "tv_strong",
      "title": "TV Strong (archive/noise/jumps)",
      "tags": ["tv", "strong"],
      "filters": {
        "highpass_hz": 80,
        "denoise_nf_db": -28,
        "compressor": { "threshold_db": -23, "ratio": 3.0, "attack_ms": 15, "release_ms": 350 },
        "limiter_db": -1.0,
        "loudnorm": { "I": -23, "TP": -1.0, "LRA": 10, "linear": true }
      }
    },
    {
      "id": "tv_ai_speech",
