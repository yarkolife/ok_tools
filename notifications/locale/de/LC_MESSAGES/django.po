msgstr "{job}: {status}"

#: event_types.py:451
msgid "Background tasks are failing"
msgstr "Hintergrundaufgaben schlagen fehl"

#: event_types.py:453
msgid ""
"Celery recorded failed tasks, for example a database backup that did not run."
msgstr ""
"Celery hat fehlgeschlagene Aufgaben erfasst, zum Beispiel ein nicht "
