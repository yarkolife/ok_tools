#: apps.py:26 templates/notifications/badge.html:3
#: templates/notifications/badge.html:9
msgid "Notifications"
msgstr "Benachrichtigungen"

#: event_types.py:26
msgid "Rental request waiting for confirmation"
msgstr "Verleihanfrage wartet auf Bestätigung"

#: event_types.py:28
msgid ""
"A person submitted a rental request that a staff member has to review and "
"confirm."
msgstr ""
"Eine Person hat eine Verleihanfrage gestellt, die von einem Mitarbeiter "
"geprüft und bestätigt werden muss."

#: event_types.py:30 event_types.py:44 event_types.py:65
#, python-brace-format
msgid "{project_name} ({user})"
msgstr "{project_name} ({user})"

#: event_types.py:42
msgid "Equipment to hand out"
msgstr "Technik zur Ausgabe"

#: event_types.py:43
msgid "Reserved equipment whose pick-up date is reached."
msgstr "Reservierte Technik, deren Abholdatum erreicht ist."

#: event_types.py:53 event_types.py:74 event_types.py:493 event_types.py:513
msgid "Days ahead"
msgstr "Tage im Voraus"

#: event_types.py:55 event_types.py:76
msgid "0 shows today only, 1 also shows tomorrow."
msgstr "0 zeigt nur heute, 1 zeigt auch morgen."

#: event_types.py:63
msgid "Equipment due back"
msgstr "Technik ist zur Rückgabe fällig"

#: event_types.py:64
msgid "Issued equipment whose return date is reached."
msgstr "Ausgegebene Technik, deren Rückgabedatum erreicht ist."

#: event_types.py:84
msgid "Rooms to open today"
msgstr "Heute Räume öffnen"

#: event_types.py:86
msgid "Confirmed room bookings that require somebody to be present."
msgstr "Bestätigte Raumbuchungen, bei denen jemand vor Ort sein muss."

#: event_types.py:87
#, python-brace-format
msgid "{start}: {room} — {project_name} ({user})"
msgstr "{start}: {room} — {project_name} ({user})"

#: event_types.py:98
msgid "Equipment was not picked up"
msgstr "Technik wurde nicht abgeholt"

#: event_types.py:100
msgid ""
"The agreed pick-up time has passed and the reservation still requires staff "
"attention."
msgstr ""
"Der vereinbarte Abholzeitpunkt ist verstrichen und die Reservierung benötigt "
"weiterhin die Aufmerksamkeit eines Mitarbeiters."

#: event_types.py:102 event_types.py:124
#, python-brace-format
msgid "{project_name} ({user}), {days_late} days late"
msgstr "{project_name} ({user}), {days_late} Tage überfällig"

#: event_types.py:110
msgid "Grace period (hours)"
msgstr "Karenzzeit (Stunden)"

#: event_types.py:113
msgid "Wait this long after the agreed pick-up before alerting."
msgstr "So lange nach der vereinbarten Abholung bis zur Meldung warten."

#: event_types.py:122
msgid "Equipment overdue"
msgstr "Technik überfällig"

#: event_types.py:123
msgid "Issued equipment that was not returned in time."
msgstr "Ausgegebene Technik, die nicht rechtzeitig zurückgegeben wurde."

#: event_types.py:132
msgid "Grace period (days)"
msgstr "Karenzzeit (Tage)"

#: event_types.py:134
msgid "Report only after the return is this many days late."
msgstr "Erst melden, wenn die Rückgabe so viele Tage überfällig ist."

#: event_types.py:138
msgid "Repeat every (days)"
msgstr "Wiederholen alle (Tage)"

#: event_types.py:140
msgid "Raise the entry again after this many days."
msgstr "Den Eintrag nach so vielen Tagen erneut melden."

#: event_types.py:149
msgid "Problem reported with rented equipment"
msgstr "Problem mit ausgeliehener Technik gemeldet"

#: event_types.py:150
msgid "Somebody recorded damage or a defect on a rental."
msgstr "Zu einer Ausleihe wurde ein Schaden oder Defekt erfasst."

#: event_types.py:151
#, python-brace-format
msgid "{item}: {issue} ({severity})"
msgstr "{item}: {issue} ({severity})"

#: event_types.py:166
msgid "New license waiting for confirmation"
msgstr "Neue Sendeerlaubnis wartet auf Genehmigung"

#: event_types.py:168
msgid ""
"Confirmation is the current blocker. The video and broadcast assets are "
"checked only after this step is complete."
msgstr ""
"Die Genehmigung ist der aktuell blockierende Schritt. Video, Cover und Reel "
"werden erst geprüft, wenn dieser Schritt abgeschlossen ist."

#: event_types.py:170 event_types.py:182 event_types.py:229
#, python-brace-format
msgid "License {number}: {title}"
msgstr "Sendeerlaubnis {number}: {title}"

#: event_types.py:180
msgid "License unconfirmed for too long"
msgstr "Sendeerlaubnis zu lange ohne Genehmigung"

#: event_types.py:181
msgid "The license has been waiting for confirmation for a while."
msgstr "Die Sendeerlaubnis wartet schon eine Weile auf die Genehmigung."

#: event_types.py:190 event_types.py:650
msgid "Days to wait"
msgstr "Wartetage"

#: event_types.py:192
msgid "Report a license once it has waited this many days."
msgstr "Eine Sendeerlaubnis melden, sobald sie so viele Tage gewartet hat."

#: event_types.py:196 event_types.py:656
msgid "Maximum pending age (days)"
msgstr "Maximales Alter offener Einträge (Tage)"

#: event_types.py:199 event_types.py:659
msgid ""
"Ignore legacy records older than this instead of turning the notification "
"centre into an archive cleanup list."
msgstr ""
"Ältere Altdaten ignorieren, damit die Benachrichtigungszentrale nicht zur "
"Liste für die Archivbereinigung wird."

#: event_types.py:210
msgid "Uploaded video waiting to be downloaded"
msgstr "Hochgeladenes Video wartet auf den Download"

#: event_types.py:212
msgid ""
"An author uploaded a video to Nextcloud and it is not on a storage location "
"yet."
msgstr ""
"Ein Autor hat ein Video zu Nextcloud hochgeladen und es liegt noch auf "
"keinem Speicherort."

#: event_types.py:214
#, python-brace-format
msgid "License {number}: {filename}"
msgstr "Sendeerlaubnis {number}: {filename}"

#: event_types.py:225
msgid "Confirmed license without a video file"
msgstr "Genehmigte Sendeerlaubnis ohne Videodatei"

#: event_types.py:227
msgid ""
"Confirmation is complete, but no available full video was found. Link or "
"import the video before continuing the broadcast workflow."
msgstr ""
"Die Genehmigung ist abgeschlossen, aber es wurde kein verfügbares "
"vollständiges Video gefunden. Verknüpfen oder importieren Sie das Video, "
"bevor der Sendeablauf fortgesetzt wird."

#: event_types.py:237
msgid "Wait after confirmation (days)"
msgstr "Wartezeit nach Genehmigung (Tage)"

#: event_types.py:240
msgid ""
"Allow uploads and automatic indexing to finish before asking staff to follow "
"up."
msgstr ""
"Uploads und automatische Indizierung abschließen lassen, bevor Mitarbeiter "
"zur Nachverfolgung aufgefordert werden."

#: event_types.py:245
msgid "Confirmed within (days)"
msgstr "Genehmigt innerhalb von (Tagen)"

#: event_types.py:247
msgid "Only look at licenses confirmed recently."
msgstr "Nur kürzlich genehmigte Sendeerlaubnisse prüfen."

#: event_types.py:260
msgid "New video found"
msgstr "Neues Video gefunden"

#: event_types.py:261
msgid "The storage scan picked up a video that nobody checked."
msgstr ""
"Der Speicher-Scan hat ein Video gefunden, das noch niemand geprüft hat."

#: event_types.py:262 event_types.py:345
#, python-brace-format
msgid "{filename} ({storage})"
msgstr "{filename} ({storage})"

#: event_types.py:273
msgid "Video format has to be converted"
msgstr "Videoformat muss konvertiert werden"

#: event_types.py:275
msgid ""
"Resolution or frame rate differ from the configured encoding preset, so the "
"file has to be transcoded."
msgstr ""
"Auflösung oder Bildrate weichen vom konfigurierten Encoding-Preset ab, die "
"Datei muss umgewandelt werden."

#: event_types.py:277
#, python-brace-format
msgid "{filename}: {deviation}"
msgstr "{filename}: {deviation}"

#: event_types.py:285 event_types.py:369
msgid "Added within (days)"
msgstr "Hinzugefügt innerhalb von (Tagen)"

#: event_types.py:287
msgid "Only check files that appeared recently."
msgstr "Nur kürzlich hinzugekommene Dateien prüfen."

#: event_types.py:298
msgid "Planned own production without a reel"
msgstr "Geplante Eigenproduktion ohne Reel"

#: event_types.py:300
msgid ""
"The license is confirmed, its full video is available and the own production "
"is scheduled, but no reel was rendered yet."
msgstr ""
"Die Sendeerlaubnis ist genehmigt, das vollständige Video ist verfügbar und "
"die Eigenproduktion ist eingeplant, aber es wurde noch kein Reel erzeugt."

#: event_types.py:302 event_types.py:324
#, python-brace-format
msgid "{date}: {number} {title}"
msgstr "{date}: {number} {title}"

#: event_types.py:310 event_types.py:332
msgid "Days before broadcast"
msgstr "Tage vor der Ausstrahlung"

#: event_types.py:312 event_types.py:334
msgid "Warn this many days before the broadcast date."
msgstr "So viele Tage vor dem Sendetermin warnen."

#: event_types.py:320
msgid "Planned own production without a cover"
msgstr "Geplante Eigenproduktion ohne Cover"

#: event_types.py:322
msgid ""
"The license is confirmed, its full video is available and its premiere is "
"scheduled, but no cover image exists."
msgstr ""
"Die Sendeerlaubnis ist genehmigt, das vollständige Video ist verfügbar und "
"die Premiere ist eingeplant, aber es ist noch kein Cover vorhanden."

#: event_types.py:343
msgid "Video without a license"
msgstr "Video ohne Sendeerlaubnis"

#: event_types.py:344
msgid "A video file could not be linked to any license."
msgstr "Eine Videodatei konnte keiner Sendeerlaubnis zugeordnet werden."

#: event_types.py:353
msgid "Storage locations to monitor"
msgstr "Zu überwachende Speicherorte"

#: event_types.py:356
msgid ""
"Only files in the selected locations are checked. No location means no "
"unlinked-video notifications."
msgstr ""
"Nur Dateien in den ausgewählten Speicherorten werden geprüft. Ohne Auswahl "
"werden keine Benachrichtigungen über nicht zugeordnete Videos erstellt."

#: event_types.py:362
msgid "Automatic linking grace period (hours)"
msgstr "Karenzzeit für automatische Zuordnung (Stunden)"

#: event_types.py:365
msgid "Alert only after automatic license linking had time to run."
msgstr ""
"Erst melden, nachdem die automatische Zuordnung Zeit zum Ausführen hatte."

#: event_types.py:371
msgid "Only report files that appeared recently."
msgstr "Nur kürzlich hinzugekommene Dateien melden."

#: event_types.py:379
msgid "File operation failed"
msgstr "Dateioperation fehlgeschlagen"

#: event_types.py:380
msgid "A render, transcode or copy job ended with an error."
msgstr "Ein Render-, Umwandlungs- oder Kopierauftrag endete mit einem Fehler."

#: event_types.py:381
#, python-brace-format
msgid "{operation}: {filename}"
msgstr "{operation}: {filename}"

#: event_types.py:391
msgid "Storage is running out of space"
msgstr "Speicherort läuft voll"

#: event_types.py:392
msgid "A storage location has little free space left."
msgstr "Auf einem Speicherort ist nur noch wenig Platz frei."

#: event_types.py:393
#, python-format, python-brace-format
msgid "{name}: {free_percent}% free ({free_gb} GB)"
msgstr "{name}: {free_percent}% frei ({free_gb} GB)"

#: event_types.py:401
msgid "Warn below (%)"
msgstr "Warnen unter (%)"

#: event_types.py:403
msgid "Report when less than this share of space is free."
msgstr "Melden, wenn weniger als dieser Anteil frei ist."

#: event_types.py:411
msgid "Storage is unavailable"
msgstr "Speicherort ist nicht erreichbar"

#: event_types.py:413
msgid ""
"An active storage location cannot be read and needs technical attention."
msgstr ""
"Ein aktiver Speicherort kann nicht gelesen werden und benötigt technische "
"Aufmerksamkeit."

#: event_types.py:415
#, python-brace-format
msgid "{name}: {path}"
msgstr "{name}: {path}"

#: event_types.py:425
msgid "Post the reel today"
msgstr "Reel heute veröffentlichen"

#: event_types.py:427
msgid ""
"A reel is ready for a contribution airing today and has to be published "
"manually."
msgstr ""
"Für einen heute ausgestrahlten Beitrag ist ein Reel fertig und muss manuell "
"veröffentlicht werden."

#: event_types.py:429 event_types.py:528
#, python-brace-format
msgid "{start}: {number} {title}"
msgstr "{start}: {number} {title}"

#: event_types.py:444
msgid "Exchange import failed"
msgstr "Austausch-Import fehlgeschlagen"

#: event_types.py:445
msgid "Downloading or importing exchange material did not work."
msgstr ""
"Das Herunterladen oder Importieren von Austauschmaterial hat nicht "
"funktioniert."

#: event_types.py:446
#, python-brace-format
msgid "{filename}: {error}"
msgstr "{filename}: {error}"

#: event_types.py:456
msgid "New material in the exchange"
msgstr "Neues Material im Austausch"

#: event_types.py:457
msgid "The exchange folder scan found material not imported yet."
msgstr ""
"Der Scan des Austauschordners hat noch nicht importiertes Material gefunden."

#: event_types.py:458
#, python-brace-format
msgid "{title} ({channel})"
msgstr "{title} ({channel})"

#: event_types.py:466
msgid "Discovered within (days)"
msgstr "Gefunden innerhalb von (Tagen)"

#: event_types.py:468
msgid "Ignore material discovered longer ago than this."
msgstr "Material ignorieren, das länger zurückliegt."

#: event_types.py:482
msgid "No broadcast plan"
msgstr "Kein Sendeplan"

#: event_types.py:483
msgid "There is no plan for one of the next days, or it is empty."
msgstr "Für einen der nächsten Tage gibt es keinen Plan oder er ist leer."

#: event_types.py:484
#, python-brace-format
msgid "{date}"
msgstr "{date}"

#: event_types.py:495
msgid "How many days ahead the plan has to exist."
msgstr "Wie viele Tage im Voraus der Plan vorhanden sein muss."

#: event_types.py:503
msgid "Planned entry without a video file"
msgstr "Geplanter Eintrag ohne Videodatei"

#: event_types.py:504
msgid "A number in the plan has no available video file."
msgstr "Zu einer Nummer im Plan gibt es keine verfügbare Videodatei."

#: event_types.py:505
#, python-brace-format
msgid "{date}, {start}: {number} {title}"
msgstr "{date}, {start}: {number} {title}"

#: event_types.py:515
msgid "How far ahead the plan is checked for missing media."
msgstr "Wie weit im Voraus der Plan auf fehlende Medien geprüft wird."

#: event_types.py:524
msgid "Live broadcast today"
msgstr "Live-Beitrag heute"

#: event_types.py:526
msgid ""
"A planned live contribution is streamed today and needs no video file, cover "
"or reel."
msgstr ""
"Ein eingeplanter Live-Beitrag wird heute gestreamt und benötigt keine "
"Videodatei, kein Cover und kein Reel."

#: event_types.py:540
msgid "Scheduled entry did not go on air"
msgstr "Geplanter Eintrag lief nicht"

#: event_types.py:542
msgid "The playout reported a scheduled start that never actually began."
msgstr "Der Playout meldete einen geplanten Start, der nie begonnen hat."

#: event_types.py:543
#, python-brace-format
msgid "{scheduled_at}: {filename}"
msgstr "{scheduled_at}: {filename}"

#: event_types.py:551
msgid "Start grace period (minutes)"
msgstr "Karenzzeit für Sendestart (Minuten)"

#: event_types.py:554
msgid "Allow a short playout delay before reporting a missed broadcast."
msgstr "Eine kurze Playout-Verzögerung vor der Meldung zulassen."

#: event_types.py:559
msgid "Look back (days)"
msgstr "Rückblick (Tage)"

#: event_types.py:561
msgid "How far back missed broadcasts are reported."
msgstr "Wie weit zurück verpasste Ausstrahlungen gemeldet werden."

#: event_types.py:575
msgid "Render job finished"
msgstr "Render-Auftrag abgeschlossen"

#: event_types.py:576
msgid "A slideshow or audio job you started has ended."
msgstr "Ein von Ihnen gestarteter Slideshow- oder Audio-Auftrag ist beendet."

#: event_types.py:577 event_types.py:590
#, python-brace-format
msgid "{job}: {status}"
msgstr "{job}: {status}"

#: event_types.py:586
msgid "Render job failed"
msgstr "Render-Auftrag fehlgeschlagen"

#: event_types.py:588
msgid "A slideshow or audio job needs attention after ending with an error."
msgstr ""
"Ein Slideshow- oder Audio-Auftrag wurde mit einem Fehler beendet und "
"benötigt Aufmerksamkeit."

#: event_types.py:604
msgid "Background tasks are failing"
msgstr "Hintergrundaufgaben schlagen fehl"

#: event_types.py:606
msgid ""
"Celery recorded failed tasks, for example a database backup that did not run."
msgstr ""
"Celery hat fehlgeschlagene Aufgaben erfasst, zum Beispiel ein nicht "
"ausgeführtes Datenbank-Backup."

#: event_types.py:608
#, python-brace-format
msgid "{task}: {count} failures"
msgstr "{task}: {count} Fehlschläge"

#: event_types.py:615
msgid "Look back (hours)"
msgstr "Rückblick (Stunden)"

#: event_types.py:617
msgid "How far back failed tasks are counted."
msgstr "Wie weit zurück fehlgeschlagene Aufgaben gezählt werden."

#: event_types.py:630
msgid "New registration waiting for verification"
msgstr "Neue Registrierung wartet auf Überprüfung"

#: event_types.py:631
msgid "Somebody registered and the profile is not verified yet."
msgstr "Jemand hat sich registriert und das Profil ist noch nicht überprüft."

#: event_types.py:632 event_types.py:643
#, python-brace-format
msgid "{name} ({email})"
msgstr "{name} ({email})"

#: event_types.py:641
msgid "Profile unverified for too long"
msgstr "Profil zu lange nicht überprüft"

#: event_types.py:642
msgid "The profile has been waiting for verification for a while."
msgstr "Das Profil wartet schon eine Weile auf die Überprüfung."

#: event_types.py:652
msgid "Report a profile once it has waited this many days."
msgstr "Ein Profil melden, sobald es so viele Tage gewartet hat."

