# ============================================================================
# API Configuration
# ============================================================================
API_PAGE_SIZE=20
API_ANON_RATE_LIMIT=100/hour
API_USER_RATE_LIMIT=1000/hour

# ============================================================================
# Security Configuration
# ============================================================================
SECURITY_SESSION_TIMEOUT=1200
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_CSRF_COOKIE_AGE=31449600


# ============================================================================
# I18n Configuration
# ============================================================================
I18N_DEFAULT_LANGUAGE=de
I18N_SUPPORTED_LANGUAGES=de,en
I18N_LOCALE_PATHS=ok_tools/locale
I18N_PHONE_REGION=DE
I18N_DATE_FORMAT=%d.%m.%Y

# ============================================================================
# Static Files Configuration
# ============================================================================
STATIC_STORAGE_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage
STATIC_URL_PREFIX=static/

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_TIMEOUT=300

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
# Number of parallel worker processes (None = auto-detect CPU cores)
# Recommended for video rendering: 2-4 (depends on CPU cores and available memory)
# Each worker process can handle one video rendering task at a time
CELERY_WORKER_CONCURRENCY=2
# Dedicated download worker concurrency. Keep at 1 so long Nextcloud downloads
# do not block quick tasks and do not run multiple downloads at once.
CELERY_DOWNLOAD_WORKER_CONCURRENCY=1
# Task time limits (in seconds)
# Soft limit: task receives SoftTimeLimitExceeded exception but can continue
# Hard limit: task is forcefully terminated
# Recommended for video rendering: 3600-7200 (60-120 minutes) for large videos
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=4200

# FFmpeg render timeout settings
# Base timeout for render subprocesses (seconds)
OKTOOLS_RENDER_TIMEOUT_SECONDS=21600
# Dynamic timeout multiplier by segment duration: max(base, duration * factor)
OKTOOLS_RENDER_TIMEOUT_FACTOR=3.0

# ============================================================================
# Docker Compose Configuration
# ============================================================================
COMPOSE_PROJECT_NAME=oktools

# ============================================================================
# Nextcloud Configuration
# ============================================================================
NEXTCLOUD_ENABLED=true
NEXTCLOUD_URL=https://cloud.lokalmedial.de
NEXTCLOUD_USERNAME=okmq_tools_service
NEXTCLOUD_PASSWORD=XXXX-XXXX-xxxx-xxxx-XXXX
NEXTCLOUD_UPLOAD_FOLDER=OKMQ/Benutzer/Videos

# Nextcloud Chunked Upload Configuration (Nextcloud 32+)
# 
# WHAT IS THIS:
# Chunked upload splits large files into smaller pieces (chunks) and uploads them
# sequentially. This is REQUIRED for Nextcloud 32+ and recommended for files > 100MB
# to avoid timeout/proxy issues.
#
# HOW IT WORKS:
# 1. File is split into chunks (default 10MB each)
# 2. Each chunk is uploaded separately via WebDAV PUT
# 3. After all chunks uploaded, they're assembled into final file
#
# NEXTCLOUD 32 COMPATIBILITY:
# - NC32 changed WebDAV URL format from /public.php/webdav/ to /public.php/dav/files/{token}/
# - This config enables proper chunked upload protocol: MKCOL -> PUT chunks -> MOVE assembly
# - Without chunked upload, files > 100MB may fail with 409/413 errors
#
# Enable chunked upload for large files (recommended: true for NC32+)
NEXTCLOUD_CHUNKED_UPLOAD_ENABLED=true
# File size threshold in MB - files larger than this will use chunked upload
NEXTCLOUD_CHUNKED_UPLOAD_THRESHOLD=100
# Chunk size in MB - size of each chunk (5-50MB recommended, default: 10MB)
# Smaller chunks = more reliable but slower. Larger chunks = faster but may timeout.
NEXTCLOUD_CHUNK_SIZE=10

# Nextcloud Calendar Integration (CalDAV) - Optional
# Enable automatic sync of room bookings to Nextcloud Calendar
NEXTCLOUD_CALENDAR_ENABLED=false
# CalDAV base URL (defaults to NEXTCLOUD_URL/remote.php/dav/calendars if not set)
NEXTCLOUD_CALDAV_BASE_URL=https://cloud.lokalmedial.de/remote.php/dav/calendars
# Calendar service account (can be same as NEXTCLOUD_USERNAME or different)
NEXTCLOUD_CALENDAR_USERNAME=ok-tools-bot
NEXTCLOUD_CALENDAR_PASSWORD=XXXX-XXXX-xxxx-xxxx-XXXX
# Default calendar name for all rooms (recommended: set this to use one calendar for all rooms)
# If set, all room bookings will be added to this calendar
NEXTCLOUD_DEFAULT_CALENDAR_NAME=
# Room to calendar mapping (optional, only used if NEXTCLOUD_DEFAULT_CALENDAR_NAME is not set)
# Format: "room_name:calendar_name,room_id:calendar_name"
# Example: "Studio 1:studio1,Schnittplatz 1:schnitt1"
# If neither NEXTCLOUD_DEFAULT_CALENDAR_NAME nor NEXTCLOUD_ROOM_CALENDARS is set, will try to use room name as calendar name
NEXTCLOUD_ROOM_CALENDARS=
