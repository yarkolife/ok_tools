"{number}_Programmvorschau_{date:%y%m%d}.mp4."
msgstr ""
"Python-Formatstring mit {number} und {date}, z. B. "
"{number}_Programmvorschau_{date:%y%m%d}.mp4."

#: models.py:186
msgid "Anchor output playout directory"
msgstr "Anchor-Ausgabeverzeichnis im Playout"

#: models.py:187
msgid ""
"Directory inside the playout storage where rendered programme preview files "
"are written."
msgstr ""
"Verzeichnis innerhalb des Playout-Speichers, in das gerenderte "
"Programmvorschau-Dateien geschrieben werden."

#: models.py:193
msgid "Anchor playout path prefix"
msgstr "Anchor-Playout-Pfadpräfix"

#: models.py:194
msgid "NAS-relative prefix sent for videos copied to playout."
msgstr ""
"NAS-relatives Präfix, das für ins Playout kopierte Videos gesendet wird."

#: models.py:199
msgid "Anchor default placeholder video"
msgstr "Anchor-Standard-Platzhaltervideo"

#: models.py:200
msgid "NAS-relative fallback video path, e.g. playout/placeholder/default.mp4."
msgstr ""
"NAS-relativer Fallback-Videopfad, z. B. playout/placeholder/default.mp4."

#: models.py:205
msgid "Anchor placeholder rules"
msgstr "Anchor-Platzhalterregeln"

#: models.py:207
msgid ""
"List of rules. Supported match values: live, title_prefix, title_contains. "
"Each rule needs a video path; title_prefix rules also need prefix; "
"title_contains rules also need contains."
msgstr ""
"Liste von Regeln. Unterstützte match-Werte: live, title_prefix, "
"title_contains. Jede Regel benötigt einen Videopfad; title_prefix-Regeln "
"benötigen zusätzlich prefix; title_contains-Regeln benötigen zusätzlich "
"contains."

#: models.py:214
msgid "Programme mail: recipients"
msgstr "Programm-Mail: Empfänger"

#: models.py:215
