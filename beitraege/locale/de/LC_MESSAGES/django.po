msgid "It is waiting for approval now. You can look at it here:"
msgstr "Er wartet jetzt auf Freigabe. Ansehen kannst du ihn hier:"

#: templates/email/beitrag_eingang_body.txt:3
msgid ""
"It is a draft: please confirm that the people on the photos agreed to the "
"publication, check the texts and submit it here:"
msgstr ""
"Er ist ein Entwurf: Bitte bestätige hier das Einverständnis der Personen auf "
"den Fotos, prüfe die Texte und reiche ihn ein:"

#: templates/email/beitrag_eingang_subject.txt:1
#, python-format
msgid "Post received: %(titel)s"
msgstr "Beitrag eingegangen: %(titel)s"

#: templates/email/beitrag_freigabe_body.txt:1
#, python-format
msgid "Hello %(name)s,"
msgstr "Hallo %(name)s,"

#: templates/email/beitrag_freigabe_body.txt:3
#, python-format
msgid "%(autor)s has submitted a post in the topic \"%(thema)s\"."
msgstr "%(autor)s hat einen Beitrag im Thema „%(thema)s“ eingereicht."

#: templates/email/beitrag_freigabe_body.txt:7
msgid "Check and approve it here (also on the phone, no login needed):"
msgstr "Hier prüfen und freigeben (auch am Handy, ohne Anmeldung):"

#: templates/email/beitrag_freigabe_body.txt:10
msgid ""
"The link is personal and valid for 7 days. One approval publishes the post "
"on all platforms switched on for it."
msgstr ""
"Der Link ist persönlich und 7 Tage gültig. Eine Freigabe veröffentlicht den "
"Beitrag auf allen gewählten Plattformen."

#: templates/email/beitrag_freigabe_subject.txt:1
#, python-format
msgid "Post to approve (%(thema)s): %(titel)s"
msgstr "Beitrag zur Freigabe (%(thema)s): %(titel)s"

#: views.py:45
msgid "top"
msgstr "oben"

#: views.py:45
msgid "middle"
msgstr "Mitte"

#: views.py:46
msgid "bottom"
msgstr "unten"

#: views.py:110
msgid "Post submitted"
msgstr "Beitrag eingereicht"

#: views.py:193
msgid "Invalid or expired link"
msgstr "Ungültiger oder abgelaufener Link"

#: views.py:194
msgid "This link is invalid or has expired. Open the post in OK-Tools instead."
msgstr ""
"Dieser Link ist ungültig oder abgelaufen. Bitte den Beitrag in OK-Tools "
"öffnen."

#: views.py:219
msgid "Sent back"
msgstr "Zurückgegeben"

#: views.py:220
msgid "The author has been told."
msgstr "Die Autorin / der Autor ist benachrichtigt."

#: views.py:225
msgid "The post cannot be approved"
msgstr "Der Beitrag kann nicht freigegeben werden"

#: views.py:229
msgid "The post is being published now."
msgstr "Der Beitrag wird jetzt veröffentlicht."

#: views.py:230
msgid "The post is published at its time."
msgstr "Der Beitrag wird zur geplanten Zeit veröffentlicht."

#: views.py:233
msgid "Nothing to do"
msgstr "Nichts zu tun"

#: views.py:234 workflow.py:155
#, python-format
msgid "This post is already %(status)s."
msgstr "Dieser Beitrag ist bereits: %(status)s."

#: views.py:237
msgid "Check the post"
msgstr "Beitrag prüfen"

#: workflow.py:112
msgid "No platform is switched on for this post."
msgstr "Für diesen Beitrag ist keine Plattform eingeschaltet."

#: workflow.py:117
msgid "Confirm that the people on the photos agreed to the publication."
msgstr "Bitte bestätigen, dass die Personen auf den Fotos einverstanden sind."

#: workflow.py:121
msgid "Instagram needs at least one photo."
msgstr "Instagram braucht mindestens ein Foto."

#: workflow.py:123
#, python-format
msgid "The Instagram text has %(count)s of at most %(max)s characters."
msgstr "Der Instagram-Text hat %(count)s von höchstens %(max)s Zeichen."

#: workflow.py:127
#, python-format
msgid "The Instagram text has %(count)s hashtags; Instagram allows %(max)s."
msgstr "Der Instagram-Text hat %(count)s Hashtags; Instagram erlaubt %(max)s."

#: workflow.py:130
msgid "The Facebook post is empty."
msgstr "Der Facebook-Beitrag ist leer."

#: workflow.py:151 workflow.py:172
msgid "You may not approve posts of this topic."
msgstr "Du darfst Beiträge dieses Themas nicht freigeben."
